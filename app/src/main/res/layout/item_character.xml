<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="14dp" android:background="@drawable/party_card_background"
    android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/txtName" style="@style/PartyNameText"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/txtRole" style="@style/PartyMutedText"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
        </LinearLayout>
        <ImageButton android:id="@+id/btnPartyActions"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/party_control_background"
            android:src="@android:drawable/ic_menu_more"
            android:tint="@color/party_text"
            android:contentDescription="@string/party_actions" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="20dp">
        <TextView style="@style/PartyHealthText" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/party_health_label" />
        <TextView android:id="@+id/txtHp" style="@style/PartyNameText"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <ProgressBar android:id="@+id/partyHpBar" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="8dp"
        android:max="100" android:progressTint="@color/party_health" android:progressBackgroundTint="@color/party_control" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <Button android:id="@+id/partyHpMinus3" style="@style/PartyButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/party_decrease_three" />
        <Button android:id="@+id/partyHpMinus1" style="@style/PartyButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/party_decrease_one" />
        <Button android:id="@+id/partyHpPlus1" style="@style/PartyButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/party_increase_one" />
        <Button android:id="@+id/partyHpPlus3" style="@style/PartyButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/party_increase_three" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="20dp">
        <TextView style="@style/PartyManaText" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/party_mana_label" />
        <TextView android:id="@+id/txtMana" style="@style/PartyNameText"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <ProgressBar android:id="@+id/partyManaBar" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="8dp"
        android:max="100" android:progressTint="@color/party_mana" android:progressBackgroundTint="@color/party_control" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <Button android:id="@+id/partyManaMinus3" style="@style/PartyButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/party_decrease_three" />
        <Button android:id="@+id/partyManaMinus1" style="@style/PartyButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/party_decrease_one" />
        <Button android:id="@+id/partyManaPlus1" style="@style/PartyButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/party_increase_one" />
        <Button android:id="@+id/partyManaPlus3" style="@style/PartyButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/party_increase_three" />
    </LinearLayout>
    <Button android:id="@+id/btnPartyReset" style="@style/PartyButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="@string/party_reset" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btnDelete" style="@style/PartyDangerButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/party_delete" />
    </LinearLayout>
</LinearLayout>
