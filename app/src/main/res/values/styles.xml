<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TitleText">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="BodyText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="PrimaryButton">
        <item name="android:padding">12dp</item>
    </style>

    <style name="PartyText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/party_text</item>
    </style>
    <style name="PartyMutedText" parent="PartyText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/party_muted</item>
    </style>
    <style name="PartyNameText" parent="PartyText">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="PartyHealthText" parent="PartyNameText">
        <item name="android:textColor">@color/party_health</item>
    </style>
    <style name="PartyManaText" parent="PartyNameText">
        <item name="android:textColor">@color/party_mana</item>
    </style>
    <style name="PartyButton" parent="Widget.AppCompat.Button">
        <item name="android:textColor">@color/party_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/party_control_background</item>
        <item name="backgroundTint">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:layout_margin">3dp</item>
    </style>
    <style name="PartyPrimaryButton" parent="PartyButton">
        <item name="android:backgroundTint">@color/party_accent</item>
        <item name="backgroundTint">@color/party_accent</item>
        <item name="android:textColor">@color/party_on_accent</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="PartyDangerButton" parent="PartyButton">
        <item name="android:textColor">@color/party_health</item>
    </style>
    <style name="ThemeOverlay.PartyMenu" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:textColor">@color/party_text</item>
        <item name="android:textColorPrimary">@color/party_text</item>
        <item name="android:textColorSecondary">@color/party_text</item>
        <item name="popupMenuStyle">@style/PartyPopupMenu</item>
    </style>
    <style name="PartyPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/party_card_background</item>
    </style>
</resources>
